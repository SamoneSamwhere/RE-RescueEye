# Used by `npm run android:apk` (vite --mode mobile) on top of .env.
# A phone cannot reach 127.0.0.1 on this laptop, so the app calls the API at the
# laptop's address on the shared Wi-Fi. Change it when the network changes, or
# point it at a hosted / tunnelled API URL.
VITE_API_BASE_URL="http://192.168.254.195:8000"

# The Android app is the Field Responder side only (see src/lib/appTarget.ts).
VITE_APP_TARGET="responder"
